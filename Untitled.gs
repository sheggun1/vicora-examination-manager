/**
 * VICORA EXAM ROOM MANAGER — standalone Google Apps Script backend
 * Database: VICORA Exam Room Manager Database only.
 * Spreadsheet ID: 12odSjNeGBTldU7rWoV27p7SHdKlkBhNdn1oWoQY_Fb0
 * No GTMC spreadsheet references, imports, or synchronisation.
 *
 * Install in a separate Apps Script project. Back up and remove any old
 * Code.gs containing duplicate doGet/doPost functions before deployment.
 */
const VICORA_DB_ID = '12odSjNeGBTldU7rWoV27p7SHdKlkBhNdn1oWoQY_Fb0';
const VICORA_ADMIN_KEY = 'CHANGE-THIS-TO-A-LONG-PRIVATE-KEY';
const VICORA_VERSION = '1.1.0';

const T = {
  Students:['StudentID','StudentName','Class','SourceSheet','ImportStatus'],
  Classes:['ClassName','StudentCount','IncludedInCurrentExam'],
  Subjects:['SubjectName'],
  SubjectRegistrations:['StudentID','StudentName','Class','Subject','RegistrationStatus','SourceSheet'],
  ExamSessions:['SessionID','SessionName','StartDate','Status'],
  RoomSettings:['SessionID','RoomNumber','RoomName','Capacity'],
  Allocations:['SessionID','StudentID','StudentName','Class','RoomNumber'],
  AllocationHistory:['SessionID','StudentID','PreviousRoom','NewRoom','Reason','Date','Administrator'],
  SystemSettings:['Setting','Value'],
  ImportLog:['Date','Operation','StudentsImported','ClassesFound','SubjectsFound','RegistrationsFound','UnmatchedStudents','AmbiguousMatches','Notes'],
  CurrentExamCandidates:['StudentID','StudentName','Class','SubjectCount','Eligibility'],
  RegistrationAudit:['Issue','StudentID','StudentName','Class','Details'],
  ExamReadiness:['Setting','Value']
};
function db_(){return SpreadsheetApp.openById(VICORA_DB_ID);}
function sheet_(n){const s=db_().getSheetByName(n);if(!s)throw Error('Missing database tab: '+n);return s;}
function rows_(n){const v=sheet_(n).getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o;});}
function ensureTabs_(){const d=db_();Object.keys(T).forEach(n=>{let s=d.getSheetByName(n);if(!s){s=d.insertSheet(n);s.getRange(1,1,1,T[n].length).setValues([T[n]]);s.setFrozenRows(1);}else if(s.getLastRow()===0)s.getRange(1,1,1,T[n].length).setValues([T[n]]);});}
function json_(o,cb){const b=JSON.stringify(o);if(cb&&/^[A-Za-z_$][\w.$]*$/.test(cb))return ContentService.createTextOutput(cb+'('+b+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(b).setMimeType(ContentService.MimeType.JSON);}
function key_(id,n,c){return[id,n,c].map(x=>String(x||'').trim().toLowerCase()).join('|');}
function admin_(k){if(String(k||'')!==VICORA_ADMIN_KEY||VICORA_ADMIN_KEY.indexOf('CHANGE-')===0)throw Error('Set the private VICORA_ADMIN_KEY in Untitled.gs first.');}
function uid_(){return'VIC-'+Utilities.getUuid().slice(0,8).toUpperCase();}
function append_(n,o){const s=sheet_(n),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);s.appendRow(h.map(k=>o[k]===undefined?'':o[k]));}
function doGet(e){try{const p=e.parameter||{},a=p.action||'status';let out;
 if(a==='status'){out={ok:true,app:'VICORA Exam Room Manager',version:VICORA_VERSION,database:db_().getName()};}
 else if(a==='lookup'){const id=String(p.studentId||'').trim(),n=String(p.name||'').trim(),c=String(p.className||'').trim();if(!id||!n||!c)throw Error('Enter student ID, full name and class.');const confirmed=rows_('ExamSessions').filter(s=>String(s.Status).toLowerCase()==='confirmed').map(s=>String(s.SessionID));const found=rows_('Allocations').filter(x=>confirmed.includes(String(x.SessionID))&&key_(x.StudentID,x.StudentName,x.Class)===key_(id,n,c));out={ok:true,allocation:found.length?found[found.length-1]:null};}
 else if(a==='previewAllocation'){admin_(p.key);out=preview_({sessionId:p.sessionId});}
 else if(a==='adminData'){admin_(p.key);ensureTabs_();out={ok:true,students:rows_('Students'),classes:rows_('Classes'),subjects:rows_('Subjects'),registrations:rows_('SubjectRegistrations'),sessions:rows_('ExamSessions'),rooms:rows_('RoomSettings'),allocations:rows_('Allocations'),candidates:rows_('CurrentExamCandidates'),readiness:rows_('ExamReadiness')};}
 else throw Error('Unsupported GET action: '+a);return json_(out,p.callback);
 }catch(err){return json_({ok:false,error:err.message},e&&e.parameter&&e.parameter.callback);}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(20000);const p=JSON.parse(e.postData&&e.postData.contents||'{}');admin_(p.key);ensureTabs_();let result;
 switch(p.action){case'setup':result={message:'Database checked. Existing records preserved.'};break;case'addStudent':result=addStudent_(p);break;case'editStudent':result=editStudent_(p);break;case'archiveStudent':result=archiveStudent_(p);break;case'addSubject':result=addSubject_(p);break;case'registerSubject':result=registerSubject_(p);break;case'removeRegistration':result=removeRegistration_(p);break;case'createSession':result=createSession_(p);break;case'saveRooms':result=saveRooms_(p);break;case'previewAllocation':result=preview_(p);break;case'confirmAllocation':result=confirm_(p);break;case'reallocate':result=reallocate_(p);break;default:throw Error('Unsupported action.');}
 return json_({ok:true,result});}catch(err){return json_({ok:false,error:err.message});}finally{try{lock.releaseLock();}catch(_){} }}
function addStudent_(p){if(!p.studentId||!p.name||!p.className)throw Error('Student ID, name and class are required.');const k=key_(p.studentId,p.name,p.className);if(rows_('Students').some(s=>key_(s.StudentID,s.StudentName,s.Class)===k))throw Error('Student already exists.');append_('Students',{StudentID:p.studentId,StudentName:p.name,Class:p.className,SourceSheet:'VICORA',ImportStatus:'Active'});return{message:'Student added.'};}
function editStudent_(p){const s=sheet_('Students'),v=s.getDataRange().getValues(),old=key_(p.oldStudentId,p.oldName,p.oldClass);let i=v.findIndex((r,j)=>j>0&&key_(r[0],r[1],r[2])===old);if(i<1)throw Error('Student not found.');if(rows_('Allocations').some(a=>key_(a.StudentID,a.StudentName,a.Class)===old))throw Error('This student has exam allocations. Do not change identity fields after allocation; preserve history and use a controlled correction.');s.getRange(i+1,1,1,5).setValues([[p.studentId,p.name,p.className,'VICORA','Active']]);return{message:'Student updated.'};}
function archiveStudent_(p){const s=sheet_('Students'),v=s.getDataRange().getValues(),k=key_(p.studentId,p.name,p.className);for(let i=1;i<v.length;i++)if(key_(v[i][0],v[i][1],v[i][2])===k){s.getRange(i+1,5).setValue('Archived');return{message:'Student archived; historical records retained.'};}throw Error('Student not found.');}
function addSubject_(p){const n=String(p.subject||'').trim();if(!n)throw Error('Subject name required.');if(rows_('Subjects').some(x=>String(x.SubjectName).toLowerCase()===n.toLowerCase()))throw Error('Subject already exists.');append_('Subjects',{SubjectName:n});return{message:'Subject added.'};}
function registerSubject_(p){const k=key_(p.studentId,p.studentName,p.className);if(!rows_('Students').some(s=>key_(s.StudentID,s.StudentName,s.Class)===k&&String(s.ImportStatus).toLowerCase()!=='archived'))throw Error('Active student not found.');if(!rows_('Subjects').some(s=>String(s.SubjectName).toLowerCase()===String(p.subject).toLowerCase()))throw Error('Subject not found.');if(rows_('SubjectRegistrations').some(r=>key_(r.StudentID,r.StudentName,r.Class)===k&&String(r.Subject).toLowerCase()===String(p.subject).toLowerCase()&&String(r.RegistrationStatus).toLowerCase()==='active'))throw Error('Registration already exists.');append_('SubjectRegistrations',{StudentID:p.studentId,StudentName:p.studentName,Class:p.className,Subject:p.subject,RegistrationStatus:'Active',SourceSheet:'VICORA'});return{message:'Subject registered.'};}
function removeRegistration_(p){const s=sheet_('SubjectRegistrations'),v=s.getDataRange().getValues(),k=key_(p.studentId,p.studentName,p.className);for(let i=1;i<v.length;i++)if(key_(v[i][0],v[i][1],v[i][2])===k&&String(v[i][3]).toLowerCase()===String(p.subject).toLowerCase()&&String(v[i][4]).toLowerCase()==='active'){s.getRange(i+1,5).setValue('Removed');return{message:'Registration removed; history retained.'};}throw Error('Active registration not found.');}
function createSession_(p){if(!p.sessionName)throw Error('Session name required.');const id=uid_();append_('ExamSessions',{SessionID:id,SessionName:p.sessionName,StartDate:p.startDate||new Date(),Status:'Draft'});return{sessionId:id,message:'Exam session created.'};}
function saveRooms_(p){if(!p.sessionId||!Array.isArray(p.rooms)||!p.rooms.length)throw Error('Add at least one room.');const se=rows_('ExamSessions').find(s=>String(s.SessionID)===String(p.sessionId));if(!se)throw Error('Session not found.');if(String(se.Status).toLowerCase()==='confirmed')throw Error('Confirmed session is locked. Use explicit reallocation.');const clean=p.rooms.map((r,i)=>{const c=Number(r.capacity),n=String(r.name||'').trim();if(!n||!Number.isInteger(c)||c<1)throw Error('Every room needs a name and positive whole-number capacity.');return{SessionID:p.sessionId,RoomNumber:i+1,RoomName:n,Capacity:c};});const s=sheet_('RoomSettings'),v=s.getDataRange().getValues();for(let i=v.length-1;i>=1;i--)if(String(v[i][0])===String(p.sessionId))s.deleteRow(i+1);clean.forEach(x=>append_('RoomSettings',x));return{message:'Room settings saved.'};}
function candidates_(){const source=rows_('CurrentExamCandidates'),students=rows_('Students').filter(s=>String(s.ImportStatus).toLowerCase()!=='archived'),classMap={};rows_('Classes').forEach(c=>classMap[String(c.ClassName).toUpperCase()]=String(c.IncludedInCurrentExam).toLowerCase());const excluded=k=>String(k).toUpperCase()==='SS2B';let list;
 if(source.length)list=source.filter(c=>String(c.Eligibility).toLowerCase()==='eligible'&&!excluded(c.Class)).map(c=>({StudentID:c.StudentID,StudentName:c.StudentName,Class:c.Class,SubjectCount:Number(c.SubjectCount)||0}));
 else list=students.filter(s=>!excluded(s.Class)&&classMap[String(s.Class).toUpperCase()]!=='no'&&!['stu001|adebayo ojo|jss1a','stu002|adetayo aveda|jss1a'].includes(key_(s.StudentID,s.StudentName,s.Class))).map(s=>({StudentID:s.StudentID,StudentName:s.StudentName,Class:s.Class,SubjectCount:0}));
 const order={};students.forEach((s,i)=>order[key_(s.StudentID,s.StudentName,s.Class)]=i);list.sort((a,b)=>(order[key_(a.StudentID,a.StudentName,a.Class)]??999999)-(order[key_(b.StudentID,b.StudentName,b.Class)]??999999));const seen={};return list.filter(c=>{const k=key_(c.StudentID,c.StudentName,c.Class);if(seen[k])return false;seen[k]=true;return true;});}
function preview_(p){const se=rows_('ExamSessions').find(s=>String(s.SessionID)===String(p.sessionId));if(!se)throw Error('Session not found.');if(String(se.Status).toLowerCase()==='confirmed'&&!p.allowConfirmed)throw Error('Already confirmed. Use reallocation.');const rooms=rows_('RoomSettings').filter(r=>String(r.SessionID)===String(p.sessionId)).sort((a,b)=>Number(a.RoomNumber)-Number(b.RoomNumber));if(!rooms.length)throw Error('Save room settings first.');const people=candidates_(),capacity=rooms.reduce((n,r)=>n+Number(r.Capacity),0);if(people.length>capacity)throw Error('Total room capacity '+capacity+' is below candidate count '+people.length+'.');const counts=rooms.map(()=>0),allocations=[];people.forEach((c,i)=>{let j=-1;for(let z=0;z<rooms.length;z++){const x=(i+z)%rooms.length;if(counts[x]<Number(rooms[x].Capacity)){j=x;break;}}if(j<0)throw Error('No room capacity remains.');counts[j]++;allocations.push({StudentID:c.StudentID,StudentName:c.StudentName,Class:c.Class,RoomNumber:Number(rooms[j].RoomNumber),RoomName:rooms[j].RoomName,SubjectCount:c.SubjectCount});});return{sessionId:p.sessionId,candidateCount:people.length,roomSummary:rooms.map((r,i)=>({roomNumber:r.RoomNumber,roomName:r.RoomName,capacity:r.Capacity,allocated:counts[i]})),allocations};}
function confirm_(p){const s=sheet_('ExamSessions'),v=s.getDataRange().getValues(),i=v.findIndex((r,j)=>j>0&&String(r[0])===String(p.sessionId));if(i<1)throw Error('Session not found.');if(String(v[i][3]).toLowerCase()==='confirmed')throw Error('This allocation is already confirmed.');const pr=preview_({sessionId:p.sessionId});if(rows_('Allocations').some(a=>String(a.SessionID)===String(p.sessionId)))throw Error('Existing allocations found. Use the reallocation workflow.');pr.allocations.forEach(x=>append_('Allocations',{SessionID:p.sessionId,StudentID:x.StudentID,StudentName:x.StudentName,Class:x.Class,RoomNumber:x.RoomNumber}));s.getRange(i+1,4).setValue('Confirmed');return{message:'Allocation confirmed and locked.',candidateCount:pr.candidateCount};}
function reallocate_(p){if(!String(p.reason||'').trim())throw Error('A reason for reallocation is required.');const s=sheet_('ExamSessions'),v=s.getDataRange().getValues(),i=v.findIndex((r,j)=>j>0&&String(r[0])===String(p.sessionId));if(i<1)throw Error('Session not found.');const old=rows_('Allocations').filter(a=>String(a.SessionID)===String(p.sessionId));if(!old.length)throw Error('No existing allocation to replace.');const pr=preview_({sessionId:p.sessionId,allowConfirmed:true}),next={};pr.allocations.forEach(x=>next[key_(x.StudentID,x.StudentName,x.Class)]=x.RoomNumber);old.forEach(a=>append_('AllocationHistory',{SessionID:p.sessionId,StudentID:a.StudentID,PreviousRoom:a.RoomNumber,NewRoom:next[key_(a.StudentID,a.StudentName,a.Class)]||'',Reason:String(p.reason).trim(),Date:new Date(),Administrator:'VICORA Admin'}));const sh=sheet_('Allocations'),av=sh.getDataRange().getValues();for(let j=av.length-1;j>=1;j--)if(String(av[j][0])===String(p.sessionId))sh.deleteRow(j+1);pr.allocations.forEach(x=>append_('Allocations',{SessionID:p.sessionId,StudentID:x.StudentID,StudentName:x.StudentName,Class:x.Class,RoomNumber:x.RoomNumber}));s.getRange(i+1,4).setValue('Confirmed');return{message:'Reallocation completed; old and new rooms recorded in history.',candidateCount:pr.candidateCount};}
